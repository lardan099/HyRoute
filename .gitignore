# Runtime binaries: downloaded by scripts/fetch-deps.ps1, never committed.
/bin/
*.exe
*.dll
*.sys

# Local dev secrets (share links, test profiles).
/.dev/

# Wails / frontend. frontend/dist IS committed so a Windows build needs
# only Go (scripts/build.ps1 -Frontend rebuilds it with npm).
/build/bin/
/frontend/node_modules/
# Windows resources (manifest, icon), generated by scripts/build.ps1.
*.syso
/tools/wdfilter/wdfilter
/dist/
